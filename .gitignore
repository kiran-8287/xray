# Dependencies
node_modules/
*/node_modules/

# Build
frontend/dist/
*.tsbuildinfo
__pycache__/

# Generated data
backend/data/storage/*.json
backend/data/library_images/
backend/data/exports/
backend/data/collage_images/
backend/data/pixel_data/
backend/data/temp/
backend/data/*.tmp

# Exported/batch data files
backend/data/items_*.json
backend/data/items_backup.json

# User-specific data (should not be shared)
backend/data/storage/customSubcategories.json

# IDE
.vscode/
.idea/
.kilo/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
frontend/.env.development

# Storage folder (all JSON data files)
backend/data/storage/

# Backup and temporary files
backend/data/storage/*.bak
backend/data/storage/.dedup_healed
backend/data/monitoring.log

# Test data files
new_data/
dump and tip/

# Test utility scripts
scripts/generate-test-files.js

# Performance test artifacts
perf/reports/*.csv
perf/reports/*.json
perf/reports/*.md
perf/scenarios/
perf/*.mjs
perf/*.py

# Monitoring scripts and reports
perf/monitoring/
perf/ANALYSIS_REPORT.md
perf/HOW_TO_RUN.md

# Temporary/diagnostic files
*.tmp
gen_before.txt
gen_after.txt
combo_*.txt
tmp_combo_diag.py
monitoring_dashboard.py
run_monitoring_dashboard.py
requirements-monitoring.txt

# Reports and generated docs (local only)
PORTABILITY_REPORT.md
PROJECT_REPORT.md

# LaTeX files
*.tex
*.aux
*.log
*.pdf
*.out
*.toc

# Test and experimental files
vanguard*
pset*
rep*test*
create*main*test*

# System configuration and runtime data
backend/data/

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Keep the data directory itself in the repository so a fresh clone has it
# (owned by the cloning user) and Docker does NOT auto-create it as root,
# which would otherwise show a red "locked / read-only" lock and block writes.
!backend/data/
!backend/data/.gitkeep
