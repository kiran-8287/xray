# Dependencies
node_modules/
*/node_modules/

# Build
frontend/dist/
*.tsbuildinfo
__pycache__/

# Generated data — the whole backend/data directory is ignored. The app writes
# everything under it: storage JSON, exported PNG/annotation folders, logs, temp
# files, user_config.json, and any user-created export folder (e.g.
# backend/data/exports2). We never commit anything under data.
backend/data/*

# IDE
.vscode/
.idea/
.kilo/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
frontend/.env.development

# Test data files
new_data/

# Load testing generated data (ignore generated seeds & runtime logs, keep code & results)
load_test/seed_data/
load_test/logs/*.log
!load_test/logs/.gitkeep

# Test utility scripts
scripts/generate-test-files.js

# Performance test artifacts
perf/reports/*.csv
perf/reports/*.json
perf/reports/*.md
perf/scenarios/
perf/*.mjs
perf/*.py

# Monitoring scripts and reports
perf/monitoring/
perf/ANALYSIS_REPORT.md
perf/HOW_TO_RUN.md

# Temporary/diagnostic files
*.tmp
gen_before.txt
gen_after.txt
combo_*.txt
tmp_combo_diag.py
monitoring_dashboard.py
run_monitoring_dashboard.py
requirements-monitoring.txt

# Reports and generated docs (local only)
PORTABILITY_REPORT.md
PROJECT_REPORT.md

# LaTeX files
*.tex
*.aux
*.log
!USER_GUIDE.pdf
*.out
*.toc

# Test and experimental files
vanguard*
pset*
rep*test*
create*main*test*

# Streamlit secrets (never commit)
.streamlit/secrets.toml

# Keep the backend/data directory itself (and its root .gitkeep) present so a
# fresh clone has the folder owned by the cloning user — this stops Docker from
# auto-creating it as root, which would show a red "locked / read-only" lock and
# block writes. The .gitkeep placeholders in each subfolder are already tracked,
# so gitignore does not affect them and every folder is recreated on clone.
!backend/data/
!backend/data/.gitkeep

ss
docs