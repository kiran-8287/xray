# ============================================
# X-Ray Backend Configuration
# ============================================
# Copy this file to .env and adjust values for your environment.
# The backend will load .env automatically on startup.

# ---- Server ----
PORT=8080
NODE_ENV=development

# ---- Authentication ----
# Set an API key to enable authentication on all write endpoints (POST, PUT, DELETE).
# If left empty/undefined, authentication is disabled (development mode).
# Generate a strong key: openssl rand -hex 32
API_KEY=

# ---- Storage Paths ----
# By default, all data is stored under backend/data/.
# Only change these if you want to store data on a different drive or location.
LIBRARY_IMAGES_PATH=backend/data/library_images
COLLAGE_IMAGES_PATH=backend/data/collage_images
PIXEL_DATA_PATH=backend/data/pixel_data
DATA_DIR=backend/data/storage
EXPORTS_PATH=backend/data/exports
TEMP_PATH=backend/data/temp

# ---- Logging ----
LOG_LEVEL=info

# ---- Upload Limits ----
# Maximum single file size in bytes (100 MB). Increase only if you have large files.
MAX_FILE_SIZE=104857600
# Maximum number of files per upload batch (5000). Increase only for large imports.
MAX_FILES_PER_UPLOAD=5000
# Upload timeout in milliseconds (30 min). Only applies to the /api/upload endpoint.
UPLOAD_TIMEOUT_MS=1800000
